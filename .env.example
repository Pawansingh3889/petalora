# Petalora environment template.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and is used for LOCAL DEVELOPMENT only.
#
# In production these do not come from a file. Secrets are set on Cloudflare
# with `wrangler secret put NAME`, and plain vars live in the `vars` block of
# wrangler.jsonc. See DEPLOY.md.

# ---------------------------------------------------------------------------
# Razorpay
# dashboard.razorpay.com -> Account & Settings -> API Keys
# ---------------------------------------------------------------------------
# Test keys start with rzp_test_, live keys with rzp_live_.
#
# The key id is public: it is sent to the browser to open Razorpay Checkout.
# Because it is inlined at build time, it must be present when you build, so
# it stays a plain var rather than a Cloudflare secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Server side only. Never sent to the browser. In production: wrangler secret put
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Razorpay Dashboard -> Settings -> Webhooks. Point it at
# https://yourdomain.com/api/webhooks/razorpay subscribed to
# payment.captured and payment.failed, then paste the secret you set there.
# This is a DIFFERENT secret from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# The placeholder x's above are detected and treated as "not configured", so a
# fresh clone runs cash-on-delivery-only instead of failing at the gateway.

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------
# Absolute URLs in the sitemap and metadata. In production this comes from the
# `vars` block in wrangler.jsonc, not from here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Password for /admin. The app refuses to authenticate against this exact
# placeholder, so change it locally and set a real one as a Cloudflare secret.
ADMIN_PASSWORD="change-me-before-launch"

# No DATABASE_URL. The database is Cloudflare D1, reached through the `DB`
# binding in wrangler.jsonc. Locally that is a Miniflare database created by
# `pnpm d1:migrate:local`.
